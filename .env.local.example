# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — real keys never get committed.

# --- OpenAI (server-side only) ---
# Your existing GPT API key. Used by /api/analyze and /api/generate.
OPENAI_API_KEY=sk-...
# Which model the analysis + generation calls use. Swap freely without code changes.
OPENAI_MODEL=gpt-4o

# --- Supabase (database + login) ---
# From your Supabase project: Settings → API.
# The URL and anon key are safe in the browser (they rely on Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key: server-side ONLY, bypasses RLS. Used by the cron news fetch later.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- NewsData.io (live news feed) ---
NEWSDATA_API_KEY=pub_...

# --- Cron protection ---
# Any long random string. Stops outsiders triggering /api/news/refresh and
# burning your NewsData quota. Vercel sends it as "Authorization: Bearer <secret>".
CRON_SECRET=
